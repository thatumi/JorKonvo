{
  "name": "@jorkonvo/matrix-core",
  "version": "0.1.5",
  "description": "Framework-agnostic Matrix protokoll wrapper (matrix-js-sdk alapokon)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./qr": {
      "types": "./dist/qrLogin.d.ts",
      "default": "./dist/qrLogin.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.7.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^42.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
