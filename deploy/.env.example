# ── Copy to .env and fill in. Then run ./scripts/provision.sh ──────────────
#
# You need DNS A/AAAA records pointing at this machine for every domain below
# that you actually use. The apex + matrix subdomain are required; the rest
# are only needed if you enable the matching compose profile.

# The "brand" domain a user types to sign in (also where the web app lives if
# you enable the `webapp` profile). e.g. chat.example.com
APEX_DOMAIN=chat.example.com

# The Matrix homeserver. Users will be @name:MATRIX_DOMAIN. Once set, this can
# never change. Often the same as APEX_DOMAIN, or matrix.example.com.
MATRIX_DOMAIN=matrix.example.com

# LiveKit (group calls) websocket host and the token service host.
LIVEKIT_DOMAIN=livekit.example.com
LK_JWT_DOMAIN=rtc-jwt.example.com

# Only used with `--profile mas` (QR-code login) / `--profile admin`.
MAS_DOMAIN=auth.example.com
ADMIN_DOMAIN=admin.example.com

# Your email - used for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Public IP of this server (for coturn / LiveKit). provision.sh auto-detects
# if left blank.
PUBLIC_IP=

# ── Secrets - leave blank, provision.sh fills these in on first run ────────
POSTGRES_PASSWORD=
REGISTRATION_SHARED_SECRET=
MACAROON_SECRET_KEY=
FORM_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SHARED_SECRET=
MAS_ENCRYPTION_KEY=
MAS_SYNAPSE_SHARED_SECRET=

# ── Policy ───────────────────────────────────────────────────────────────
# Open registration? "true" lets anyone make an account (add a CAPTCHA or
# email verification before doing this publicly). "false" = invite/admin only.
ENABLE_OPEN_REGISTRATION=false
