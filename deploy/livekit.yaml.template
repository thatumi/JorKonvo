# LiveKit SFU. Runs with network_mode: host so the UDP media range and the
# embedded TURN/TCP fallback are directly reachable.
port: 7880
bind_addresses:
  - 0.0.0.0

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true

# API key/secret pair the token service (lk-jwt) signs tokens with.
# provision.sh writes these from .env.
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

# Embedded TURN so clients behind strict NATs / UDP-blocked networks can still
# connect. Caddy already owns 443, so LiveKit's TLS TURN listens on 5349 and
# coturn covers 3478/443 fallback.
turn:
  enabled: true
  domain: ${LIVEKIT_DOMAIN}
  tls_port: 5349
  udp_port: 3478
  external_tls: true

logging:
  level: info
  json: false

room:
  auto_create: false
  empty_timeout: 120
  max_participants: 0
