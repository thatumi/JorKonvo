<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same App Group as App/App.entitlements - this is the extension's only
	     channel back to the containing app (separate processes). See
	     SampleHandler.swift and App/ScreenSharePlugin.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.szabotar.jorkonvo</string>
	</array>
</dict>
</plist>
