{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JorKonvo",
  "version": "0.1.4",
  "identifier": "com.jorkonvo.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-BqpGXM4svq2z3tEACP96WoQa/Rn545bnI3Y3OYkbgio='; style-src 'self' 'unsafe-inline'; img-src 'self' https: blob: data:; media-src 'self' https: blob: data:; font-src 'self' data:; connect-src 'self' https: wss: ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Tam\u00e1s Szab\u00f3 <szabotar@szabotar.dev>",
    "category": "SocialNetworking",
    "shortDescription": "Discord-style Matrix client",
    "longDescription": "JorKonvo is a Discord-style client for the Matrix protocol: servers (spaces), roles, voice and video calls, end-to-end encryption. This is the desktop build (Tauri + embedded Chromium).",
    "linux": {
      "deb": {
        "section": "net",
        "provides": [
          "jorkonvo"
        ],
        "depends": [
          "libgtk-3-0t64 | libgtk-3-0",
          "libnss3",
          "libnspr4",
          "libatk1.0-0t64 | libatk1.0-0",
          "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
          "libcups2t64 | libcups2",
          "libasound2t64 | libasound2",
          "libgbm1",
          "libxkbcommon0",
          "libdrm2",
          "libdbus-1-3",
          "libexpat1",
          "libx11-6",
          "libx11-xcb1",
          "libxi6",
          "libxkbcommon-x11-0",
          "libwayland-client0",
          "libgdk-pixbuf-2.0-0",
          "libxcb1",
          "libxcomposite1",
          "libxdamage1",
          "libxext6",
          "libxfixes3",
          "libxrandr2",
          "libpango-1.0-0",
          "libcairo2",
          "fontconfig",
          "fonts-dejavu-core | fonts-liberation | fonts-noto-core"
        ],
        "recommends": [
          "xdg-desktop-portal",
          "pipewire-pulse | pulseaudio"
        ]
      }
    }
  }
}
