{
  "name": "jorkonvo",
  "private": true,
  "version": "0.1.3",
  "description": "Discord-szeru Matrix kliens - monorepo root",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:matrix-core": "npm run build --workspace=packages/matrix-core",
    "build": "npm run build:matrix-core && npm run build:web",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "lint": "npm run lint --workspace=apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
